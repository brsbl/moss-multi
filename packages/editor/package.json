{
  "name": "@moss-multi/editor",
  "version": "0.2.0",
  "description": "A moss note, editable, in a host's frame: moss's own editor writing Moss desktop's files through a host bridge.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brsbl/moss-multi.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/moss-editor.js",
    "./moss-editor.css": "./dist/moss-editor.css",
    "./moss-editor-host.js": "./dist/moss-editor-host.js",
    "./moss-html-frame.html": "./dist/moss-html-frame.html",
    "./editor.json": "./dist/editor.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "build:host": "tsc -p tsconfig.contract.json && node scripts/build-host.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "24.13.3",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.4",
    "charter-webfont": "4.1.0",
    "jotai": "2.20.2",
    "lexical": "0.48.0",
    "@lexical/markdown": "0.48.0",
    "postcss": "8.5.25",
    "prismjs": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
