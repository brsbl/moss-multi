{
  // Emits contract.d.ts for the moss-editor-host artifact.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/moss-editor-host"
  },
  "files": ["src/contract.ts"]
}
