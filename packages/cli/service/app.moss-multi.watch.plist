<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- moss-multi watch as a launchd agent (docs/SYNC.md). Replace /Users/YOU with your home folder and the last
     argument with the workspace, install to ~/Library/LaunchAgents/, then: launchctl bootstrap gui/$(id -u) <plist> -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.moss-multi.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/YOU/.local/lib/moss-multi/moss-multi-watch.sh</string>
    <string>/Users/YOU/.config/moss-multi/watch.env</string>
    <string>/Users/YOU/Moss/Notes</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MOSS_MULTI_NO_OPEN</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/moss-multi/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/moss-multi/watch.log</string>
</dict>
</plist>
