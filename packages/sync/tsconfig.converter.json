{
  // The converter and its tests, with the vendored moss closure they import (DOM types, JSX, moss's aliases).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@moss/shared": ["../../vendor/moss/packages/shared/src/index.ts"],
      "@moss/shared/*": ["../../vendor/moss/packages/shared/src/*"],
      "@/*": ["../../vendor/moss/packages/shared/src/*"],
      "@moss-desktop/*": ["../../vendor/moss/packages/desktop/src/*"]
    }
  },
  "include": ["src/converter/**/*.ts", "test/**/*.ts", "measure/**/*.ts"]
}
