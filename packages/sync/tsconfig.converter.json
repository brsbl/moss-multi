{
  // The converter and its tests, with the vendored moss closure they import (DOM types, JSX, moss's aliases).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@moss/shared": ["../../vendor/moss/packages/shared/src/index.ts"],
      "@moss/shared/*": ["../../vendor/moss/packages/shared/src/*"],
      "@/*": ["../../vendor/moss/packages/shared/src/*"],
      "@moss-desktop/*": ["../../vendor/moss/packages/desktop/src/*"],
      "@moss-multi/host/*": ["../../apps/web/src/host/*"]
    }
  },
  "include": ["src/converter/**/*.ts", "test/*.ts", "test/parity/**/*.ts", "test/views/**/*.ts", "test/workerd/**/*.ts", "measure/**/*.ts"],
  // The DO measurement Workers need the Workers types: tsconfig.json checks them.
  "exclude": ["measure/doc-worker.ts", "measure/search-worker.ts"]
}
