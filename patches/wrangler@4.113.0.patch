+// moss-multi patch (workers-sdk#14641): kj closes an idle keep-alive connection 5 s after its last use, at both the
+// Worker (server) and this pool (client), and the pool hands out the most recently returned connection first. A forward
+// that must not be replayed and would take a connection 4.5 s or more idle waits until that connection is closed
+// (5.3 s, a margin for the response body), so it opens a fresh one. `returned` models the pool: when each idle
+// connection was returned, stamped at its response headers, oldest first.
+var IDLE_CLOSE_MS = 5300;
+var IDLE_RISK_MS = 4500;
+async function takeIdle(returned, waitOutClose) {
+  for (;;) {
+    const now = Date.now();
+    while (returned.length > 0 && now - returned[0] >= IDLE_CLOSE_MS) returned.shift();
+    const age = returned.length > 0 ? now - returned[returned.length - 1] : 0;
+    if (!waitOutClose || age < IDLE_RISK_MS) {
+      returned.pop();
+      return;
+    }
+    await new Promise((resolve) => setTimeout(resolve, IDLE_CLOSE_MS - age));
+  }
