    "ci:trace": "node scripts/ci/trace.mjs",
    "ci:minutes": "node scripts/ci/minutes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "lexical": "0.48.0",
      "@lexical/clipboard": "0.48.0",
      "@lexical/code": "0.48.0",
      "@lexical/code-core": "0.48.0",
      "@lexical/code-prism": "0.48.0",
      "@lexical/devtools-core": "0.48.0",
      "@lexical/dragon": "0.48.0",
      "@lexical/extension": "0.48.0",
