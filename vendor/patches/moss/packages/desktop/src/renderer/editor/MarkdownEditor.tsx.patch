-  replace: (parentNode, _children, match) => {
-    const mediaNode = createMediaNodeFromMarkdownImage(match[0]);
-    if (!mediaNode) {
-      return;
-    }
-    parentNode.replace(mediaNode);
-  },
-  type: 'element'
-};
