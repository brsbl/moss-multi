diff --git a/packages/desktop/src/renderer/editor/MarkdownEditor.css b/packages/desktop/src/renderer/editor/MarkdownEditor.css
--- a/packages/desktop/src/renderer/editor/MarkdownEditor.css
+++ b/packages/desktop/src/renderer/editor/MarkdownEditor.css
@@ -923,6 +923,12 @@ html[data-moss-comment-ui-open="true"] .editor-block-gap-cursor-line {
   opacity: 0 !important;
 }
 
+/* moss-multi seam: read-only-decorators (T3.8): a read-only body offers no insert-paragraph gaps (DecoratorBlockPlugin
+   ignores them too). */
+[data-moss-note-editor-root][contenteditable="false"] [data-block-gap-cursor] {
+  display: none;
+}
+
 html[data-moss-comment-ui-open="true"] .comment-highlight-active .editor-block-gap-cursor-line {
   opacity: 1 !important;
   background-color: var(--comment-color, theme('colors.accent-brand')) !important;
@@ -1173,3 +1179,10 @@ html[data-moss-comment-ui-open="true"] .comment-highlight-active .editor-block-g
 .moss-tab-group > [data-tab-panel][data-active] {
   display: block;
 }
+
+/* moss-multi seam: local-view (A§10): formula drafts are local paint, without splitting shared text. */
+::highlight(formula-draft) {
+  /* moss's draft chip colors (MathCalculationPlugin FORMULA_CHIP_BASE_STYLE); a highlight cannot pad or round. */
+  background-color: var(--surface-note-selected-bright);
+  color: var(--accent-brand-pressed);
+}
